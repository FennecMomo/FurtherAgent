<Window x:Class="FurtherAgent.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FurtherAgent.Client" Title="FurtherAgent · 0.6.8" Icon="Assets/FurtherAgent.ico" Width="1240" Height="840" MinWidth="940" MinHeight="650" Background="#FCFCFA" Foreground="#202C32" FontFamily="Microsoft YaHei UI" FontSize="13" Closing="Window_Closing">
 <Window.Resources><local:HalfFontMarginConverter x:Key="HalfFontMargin"/></Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F1F3EE" BorderBrush="#E1E5DD" BorderThickness="0,0,1,0" Padding="18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="8,10,0,22"><Image Source="Assets/FurtherAgent.png" Width="36" Height="36" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="FurtherAgent" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <Button x:Name="NewButton" Content="＋  新建会话" Style="{StaticResource Primary}" Click="New_Click" ToolTip="连接远端后新建会话"/>
     <Button Content="恢复归档" Click="RestoreArchive_Click"/><Button Content="会话" Click="Conversations_Click" HorizontalContentAlignment="Left"/>
     <TextBlock Text="搜索会话" Foreground="#738079" Margin="8,12,0,0"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="搜索会话标题" AutomationProperties.Name="搜索会话"/>
     <DockPanel Margin="8,4,0,8"><Button x:Name="RefreshButton" Content="刷新" DockPanel.Dock="Right" Padding="8,3" Click="Refresh_Click" IsEnabled="False"/><TextBlock Text="最近会话" Foreground="#738079" VerticalAlignment="Center"/></DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <TextBlock x:Name="RemoteStatus" Text="尚未连接设备" Foreground="#65736B" TextWrapping="Wrap" Margin="8,0,8,8"/>
     <Button Content="连接设备" Click="OpenConnect_Click"/>
     <Button Content="设置" Click="Settings_Click"/>
     <TextBlock Text="0.6.8  ·  远程工作空间" Foreground="#879188" FontSize="11" Margin="8,10,0,0"/>
    </StackPanel>
    <ListBox x:Name="SessionList" Background="Transparent" BorderThickness="0" SelectionChanged="Session_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Title}"/><TextBlock Text="{Binding DisplayTime}" Foreground="#7E8981" FontSize="11" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,20,30,14">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="ConversationPage">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
     <Button x:Name="ArchiveButton" DockPanel.Dock="Right" Style="{StaticResource Compact}" VerticalAlignment="Top" Content="归档" Click="Archive_Click" IsEnabled="False"/><Button DockPanel.Dock="Right" Content="复制对话" Click="CopyChat_Click" Style="{StaticResource Compact}" VerticalAlignment="Top"/>
     <StackPanel><TextBlock x:Name="SessionTitle" Text="从一段对话开始" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="SessionMeta" Text="连接设备，选择已有会话或新建会话。" TextWrapping="Wrap" Foreground="#748078" Margin="0,8,0,0"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">


     <StackPanel Panel.ZIndex="1" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="410"><TextBlock x:Name="EmptyTitle" Text="你的 Agent，随时继续。" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="在这里阅读消息、给出指令并处理确认。&#10;设备和服务端配置都在「设置」中。" TextAlignment="Center" Foreground="#7A877E" TextWrapping="Wrap" Margin="0,16,0,20"/><Button x:Name="EmptyConnect" Content="连接远端设备" Click="OpenConnect_Click" HorizontalAlignment="Center"/></StackPanel>
     <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="Messages"><ItemsControl.ItemTemplate><DataTemplate><local:ChatMessageView/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" x:Name="PromptBorder" Visibility="Collapsed" Background="#FFF2D7" CornerRadius="9" Padding="15" Margin="0,8,0,10" MaxHeight="235"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PromptPanel"/></ScrollViewer></Border>
    <StackPanel Grid.Row="3">
     <WrapPanel x:Name="ConversationTools" Margin="0,0,0,4">
      <Button Style="{StaticResource IconButton}" Click="PasteImage_Click" ToolTip="粘贴图片" AutomationProperties.Name="粘贴图片"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M3,3 L17,3 17,17 3,17 Z M3,13 L7,9 11,13 14,10 17,13 M7,6 L8,6 8,7 7,7 Z"/></Button>
      <Button x:Name="UploadButton" Style="{StaticResource IconButton}" Click="Upload_Click" IsEnabled="False" ToolTip="添加文件" AutomationProperties.Name="添加文件"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M7,11 L12,6 Q16,2 18,6 Q19,8 16,11 L9,18 Q5,21 2,17 Q0,14 4,10 L11,3 M5,13 L12,6"/></Button>
      <Button x:Name="FilesButton" Style="{StaticResource IconButton}" Click="Files_Click" IsEnabled="False" ToolTip="会话文件 / 下载" AutomationProperties.Name="会话文件 / 下载"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M2,16 L2,4 8,4 10,6 18,6 18,16 Z M10,8 L10,14 M7,11 L10,14 13,11"/></Button>
      <Button x:Name="ClearFilesButton" Style="{StaticResource IconButton}" Click="ClearFiles_Click" ToolTip="移除待发附件" AutomationProperties.Name="移除待发附件"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M3,5 L17,5 M7,5 L7,2 13,2 13,5 M5,5 L6,18 14,18 15,5 M8,8 L8,15 M12,8 L12,15"/></Button>
      <Button x:Name="CancelTransferButton" Content="取消传输" Click="CancelTransfer_Click" Visibility="Collapsed" Style="{StaticResource Compact}"/>
     </WrapPanel>
    <Border BorderBrush="#CFD9CF" BorderThickness="1" CornerRadius="12" Background="White" Padding="0" Margin="0">
     <StackPanel>
      <TextBlock x:Name="AttachmentSummary" TextWrapping="Wrap" Foreground="#537363"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox x:Name="Composer" Padding="0" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" TextAlignment="Left" MinHeight="76" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfFontMargin}}" IsEnabled="False" PreviewKeyDown="Composer_KeyDown" AutomationProperties.Name="消息输入"/>
      <DockPanel><Button Margin="0" x:Name="SendButton" DockPanel.Dock="Right" Content="发送" Click="Send_Click" Style="{StaticResource CompactPrimary}" IsEnabled="False"/><Button Margin="0" x:Name="InterruptSendButton" DockPanel.Dock="Right" Content="打断并发送" Click="InterruptSend_Click" ToolTip="停止当前运行，确认结束后发送新消息" Style="{StaticResource Compact}" IsEnabled="False"/><Button Margin="0" x:Name="StopButton" DockPanel.Dock="Right" Content="停止" Click="Stop_Click" Style="{StaticResource Compact}" IsEnabled="False"/><StackPanel Orientation="Horizontal"><Button Margin="0" x:Name="ModelButton" MaxWidth="260" Content="模型与模式" Click="Model_Click" Style="{StaticResource Compact}" IsEnabled="False"/><TextBlock Text="Ctrl + Enter 发送" Foreground="#859088" FontSize="11" VerticalAlignment="Center"/></StackPanel></DockPanel>
     </StackPanel>
    </Border>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="660" HorizontalAlignment="Left">
     <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="配置连接与本机共享，回到会话即可继续工作。" Foreground="#77847B" Margin="0,8,0,30"/>
     <TextBlock Text="中继服务" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="服务端地址" Margin="0,16,0,0"/><TextBox x:Name="ServerUrl" Text="https://furtheragent.fennecmomo.top" MinWidth="540"/><Button Content="保存地址" Click="SaveSettings_Click" HorizontalAlignment="Left"/><TextBlock Text="保存后用于下一次连接。双方使用同一中继，连接设备只需授权码。" TextWrapping="Wrap" Foreground="#77847B" Margin="0,8,0,24"/>
     <TextBlock Text="当前远端" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="AgentPicker" IsEnabled="False"/><Button x:Name="DisconnectButton" Content="断开远端连接" Click="Disconnect_Click" IsEnabled="False" HorizontalAlignment="Left"/>
     <Button Content="忘记已保存连接" Click="ForgetConnection_Click" HorizontalAlignment="Left"/><TextBlock Text="成功连接后记住设备，启动时自动重连。主动断开后暂停自动连接；授权码仅当前 Windows 用户可解密。" TextWrapping="Wrap" Foreground="#77847B"/><Separator Margin="0,22"/><TextBlock Text="共享本机 Agent" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="在这台电脑打开 Codex，然后开启共享。授权码仅提供给可信任的人。" TextWrapping="Wrap" Foreground="#77847B" Margin="0,10"/>
     <ComboBox x:Name="LocalBackend" SelectedIndex="0"><ComboBoxItem Content="Codex 桌面"/><ComboBoxItem Content="DSH 桌面（同一 Host）"/><ComboBoxItem Content="DSH 独立后台（隔离会话）"/></ComboBox>
       <TextBlock Text="DSH 桌面程序路径（后台模式使用其匹配运行时）" Foreground="#77847B"/><TextBox x:Name="DshExecutable" Text="D:\Software\DeepseekHarness\DeepSeek Harness.exe"/>
       <Button x:Name="ShareButton" Content="开启共享" Click="Share_Click" HorizontalAlignment="Left"/><TextBox x:Name="LocalCode" IsReadOnly="True" Text="尚未开启共享" FontFamily="Consolas"/><Button x:Name="CopyCodeButton" Content="复制授权码" Click="CopyCode_Click" IsEnabled="False" HorizontalAlignment="Left"/><Button Content="重置本机配对码" Click="ResetPairing_Click" ToolTip="停止本机共享并更换配对码；日常重启和更新不需要重置" HorizontalAlignment="Left"/><TextBlock x:Name="HostStatus" Text="共享停止时会断开远程控制端。" TextWrapping="Wrap" Foreground="#77847B"/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="1" Margin="0,6,0,0"><WrapPanel><TextBlock x:Name="RelayHealth" Text="中继：未连接" FontSize="11" Margin="0,0,18,0"/><TextBlock x:Name="HostHealth" Text="客户端 B：未连接" FontSize="11"/></WrapPanel><TextBlock x:Name="ActivityStatus" Text="连接未就绪" Foreground="#537363" FontSize="12" Margin="0,3,0,0"/><TextBlock x:Name="StatusBar" Text="就绪" Foreground="#758178" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="40"/></StackPanel>
  </Grid>
  <Border x:Name="ConnectOverlay" Grid.ColumnSpan="2" Background="#660F2118" Visibility="Collapsed">
   <Border Background="#FCFCFA" CornerRadius="14" Padding="30" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="连接设备" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="输入远端设备显示的授权码。" Margin="0,12" Foreground="#748078"/><TextBlock x:Name="ConnectServer" TextWrapping="Wrap" Foreground="#748078"/><TextBox x:Name="RemoteCode" FontFamily="Consolas" FontSize="18" AutomationProperties.Name="远端授权码"/><TextBlock x:Name="ConnectError" Foreground="#A34036" TextWrapping="Wrap"/><WrapPanel><Button x:Name="ConnectButton" Content="连接" Click="Connect_Click" Style="{StaticResource Primary}"/><Button Content="取消" Click="CloseOverlay_Click"/><Button Content="修改服务端" Click="Settings_Click"/></WrapPanel></StackPanel></Border>
  </Border>
  <Border x:Name="NewOverlay" Grid.ColumnSpan="2" Background="#660F2118" Visibility="Collapsed"><Border Background="#FCFCFA" CornerRadius="14" Padding="30" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="新建会话" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="NewHint" TextWrapping="Wrap" Margin="0,12"/><TextBox x:Name="NewTitle" Text="新会话" AutomationProperties.Name="新会话标题"/><TextBlock x:Name="NewError" Foreground="#A34036" TextWrapping="Wrap"/><WrapPanel><Button x:Name="CreateButton" Content="创建并打开" Style="{StaticResource Primary}" Click="Create_Click"/><Button Content="返回" Click="CloseOverlay_Click"/></WrapPanel></StackPanel></Border></Border>
  <Border x:Name="ModelOverlay" Grid.ColumnSpan="2" Background="#660F2118" Visibility="Collapsed"><Border Background="#FCFCFA" CornerRadius="14" Padding="30" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="模型与模式" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="模型（可输入远端可用的模型 ID）" Margin="0,18,0,0"/><ComboBox x:Name="ModelPicker" IsEditable="True" DisplayMemberPath="Id" SelectionChanged="ModelSelection_Changed"/><TextBlock Text="提供商"/><TextBox x:Name="ProviderText"/><TextBlock Text="执行模式"/><ComboBox x:Name="ModePicker" SelectedIndex="0"><ComboBoxItem Content="Build · 执行任务" Tag="default"/><ComboBoxItem Content="Plan · 规划任务" Tag="plan"/></ComboBox><TextBlock x:Name="ModelHint" Foreground="#748078" TextWrapping="Wrap"/><TextBlock x:Name="ModelError" Foreground="#A34036" TextWrapping="Wrap" Margin="0,8"/><WrapPanel><Button x:Name="ApplyModelButton" Content="应用设置" Style="{StaticResource Primary}" Click="ApplyModel_Click"/><Button Content="返回" Click="CloseOverlay_Click"/></WrapPanel></StackPanel></Border></Border>
  <Border x:Name="FilesOverlay" Grid.ColumnSpan="2" Background="#660F2118" Visibility="Collapsed"><Border Background="#FCFCFA" CornerRadius="14" Padding="26" Width="650" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="会话文件" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="上传文件与 Agent 输出文件 · 选择后保存到本机" Foreground="#748078" Margin="0,10"/><TextBlock x:Name="FilesStatus" TextWrapping="Wrap" Margin="0,6"/></StackPanel><WrapPanel DockPanel.Dock="Bottom"><Button Content="预览图片" Click="PreviewImage_Click"/><Button x:Name="DownloadButton" Content="下载选中文件" Click="Download_Click"/><Button Content="关闭" Click="CloseOverlay_Click"/></WrapPanel><ListBox x:Name="RemoteFiles" MinHeight="180" MaxHeight="330" DisplayMemberPath="DisplayName"/></DockPanel></Border></Border>
 </Grid>
</Window>
