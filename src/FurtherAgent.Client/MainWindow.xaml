<Window x:Class="FurtherAgent.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FurtherAgent.Client" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="FurtherAgent · 0.9.1" Icon="Assets/FurtherAgent.ico" Width="1240" Height="960" MinWidth="940" MinHeight="650" Background="{DynamicResource BrushFCFCFA}" Foreground="{DynamicResource Brush202C32}" FontFamily="{DynamicResource UIFont}" FontSize="{DynamicResource UIFontSize}" Closing="Window_Closing">
 <Window.Resources><local:HalfFontMarginConverter x:Key="HalfFontMargin"/></Window.Resources>
 <Grid Background="{DynamicResource ShellBackground}">
  <Grid.RowDefinitions><RowDefinition Height="{DynamicResource TopbarHeight}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Visibility="{DynamicResource CodexOnly}" LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE921;"/></Button>
    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化 / 还原"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE922;"/></Button>
    <Button Style="{StaticResource CaptionButton}" Click="WindowClose_Click" ToolTip="关闭到托盘" AutomationProperties.Name="关闭到托盘"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;"/></Button>
   </StackPanel>
   <StackPanel Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
    <Button Style="{StaticResource RailButton}" Width="48" Height="32" Click="ToggleSidebar_Click" ToolTip="展开 / 折叠侧栏" AutomationProperties.Name="展开 / 折叠侧栏"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE700;" FontSize="16"/></Button>
    <Menu FontFamily="{DynamicResource UIFont}" FontSize="{DynamicResource UIFontSize}" Background="Transparent" Foreground="#919191" VerticalAlignment="Center">
     <MenuItem Header="文件"><MenuItem Header="新聊天" Click="New_Click"/><MenuItem Header="连接设备" Click="OpenConnect_Click"/><MenuItem Header="设置" Click="Settings_Click"/></MenuItem>
     <MenuItem Header="编辑"><MenuItem Header="剪切输入" Click="Cut_Click"/><MenuItem Header="粘贴到输入框" Click="Paste_Click"/><MenuItem Header="复制对话" Click="CopyChat_Click"/></MenuItem>
     <MenuItem Header="视图"><MenuItem Header="显示 / 隐藏侧栏" Click="ToggleSidebar_Click"/><MenuItem Header="显示 / 隐藏连接诊断" Click="Diagnostics_Click"/><Separator/><MenuItem Header="Codex 风格" Click="CodexTheme_Click"/><MenuItem Header="原始风格" Click="OriginalTheme_Click"/></MenuItem>
     <MenuItem Header="帮助"><MenuItem Header="关于 FurtherAgent" Click="About_Click"/></MenuItem>
    </Menu>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource RailWidth}"/><ColumnDefinition Width="{DynamicResource SidebarWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0" Visibility="{DynamicResource CodexOnly}" Margin="7,8,7,10">
   <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Click="Settings_Click" ToolTip="设置与界面风格" AutomationProperties.Name="设置与界面风格"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;"/></Button>
   <StackPanel>
    <Button Style="{StaticResource RailButton}" Background="#ECE7E3" Click="Conversations_Click" ToolTip="会话" AutomationProperties.Name="会话"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;"/></Button>
    <Button Style="{StaticResource RailButton}" Click="OpenConnect_Click" ToolTip="连接设备" AutomationProperties.Name="连接设备"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE839;"/></Button>
    <Button Style="{StaticResource RailButton}" Click="RestoreArchive_Click" ToolTip="恢复归档" AutomationProperties.Name="恢复归档"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE81C;"/></Button>
    <Button Style="{StaticResource RailButton}" Click="Files_Click" IsEnabled="{Binding IsEnabled, ElementName=FilesButton}" ToolTip="会话文件" AutomationProperties.Name="会话文件"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;"/></Button>
    <Separator Margin="8,14"/>
    <Button Style="{StaticResource RailButton}" Click="Diagnostics_Click" ToolTip="连接状态" AutomationProperties.Name="连接状态"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;"/></Button>
   </StackPanel>
  </DockPanel>
  <Border x:Name="SidebarSurface" Grid.Column="1" CornerRadius="{DynamicResource SidebarRadius}" Background="{DynamicResource BrushF1F3EE}" BorderBrush="{DynamicResource BrushE1E5DD}" BorderThickness="0,0,1,0" Padding="{DynamicResource SidebarPadding}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="8,10,0,22" Visibility="{DynamicResource OriginalOnly}"><Image Source="Assets/FurtherAgent.png" Width="36" Height="36" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="FurtherAgent" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <DockPanel Visibility="{DynamicResource CodexOnly}" Margin="8,0,4,12">
      <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIcon}" Click="SearchFocus_Click" ToolTip="搜索会话" AutomationProperties.Name="搜索会话"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;"/></Button>
      <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIcon}" Click="OpenConnect_Click" ToolTip="切换连接" AutomationProperties.Name="切换连接"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8F2;"/></Button>
      <TextBlock Text="Codex" FontSize="{DynamicResource BrandSize}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="FurtherAgent · Codex 风格"/>
     </DockPanel>
     <ComboBox x:Name="ConnectedDevices" DisplayMemberPath="Label" SelectionChanged="ConnectedDevice_Changed" Visibility="Collapsed" Margin="4,0,4,8" ToolTip="切换已连接设备，其他连接继续保持" AutomationProperties.Name="切换已连接设备"/>
     <Button x:Name="NewButton" Content="{DynamicResource NewChatLabel}" Style="{StaticResource SidebarPrimary}" Click="New_Click" ToolTip="连接远端后新建会话"/>
     <Button x:Name="WorkspaceButton" Style="{StaticResource SidebarAction}" Content="＋  添加工作空间" Click="Workspace_Click" ToolTip="选择远端已有目录，或在远端创建文件夹" Visibility="Collapsed"/>
     <Button Content="{DynamicResource ArchiveLabel}" Click="RestoreArchive_Click" Style="{StaticResource SidebarAction}"/><Button Content="会话" Click="Conversations_Click" HorizontalContentAlignment="Left" Visibility="{DynamicResource OriginalOnly}"/>
     <TextBlock Visibility="{DynamicResource OriginalOnly}" Text="搜索会话 / 工作空间" Foreground="{DynamicResource Brush738079}" Margin="8,12,0,0"/><TextBox x:Name="SearchBox" Visibility="{DynamicResource SearchVisibility}" TextChanged="Search_Changed" ToolTip="搜索会话标题或远端工作目录" AutomationProperties.Name="搜索会话"/>
     <DockPanel Margin="8,4,0,8"><Button x:Name="RefreshButton" Content="刷新" DockPanel.Dock="Right" Padding="8,3" Click="Refresh_Click" IsEnabled="False"/><TextBlock Text="{DynamicResource GroupHeader}" Foreground="{DynamicResource Brush738079}" VerticalAlignment="Center"/></DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <TextBlock x:Name="RemoteStatus" Text="尚未连接设备" Foreground="{DynamicResource Brush65736B}" TextWrapping="Wrap" Margin="8,0,8,8"/>
     <Button Content="连接设备" Click="OpenConnect_Click" Style="{StaticResource SidebarAction}"/>
     <Button Content="设置" Click="Settings_Click" Visibility="{DynamicResource OriginalOnly}"/>
     <TextBlock x:Name="VersionLabel" Text="远程工作空间" Visibility="{DynamicResource OriginalOnly}" Foreground="{DynamicResource Brush879188}" FontSize="11" Margin="8,10,0,0"/>
    </StackPanel>
    <TreeView Margin="{DynamicResource SessionListMargin}" x:Name="SessionList" ItemContainerStyle="{DynamicResource ActiveTreeStyle}" Background="Transparent" BorderThickness="0" SelectedItemChanged="Session_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <TreeView.Resources>
      <HierarchicalDataTemplate DataType="{x:Type local:WorkspaceGroup}" ItemsSource="{Binding Sessions}"><StackPanel ToolTip="{Binding Path}" MaxWidth="{DynamicResource GroupWidth}"><TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Visibility="{DynamicResource OriginalOnly}" TextTrimming="CharacterEllipsis"/><DockPanel Visibility="{DynamicResource CodexOnly}"><TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Visibility="{DynamicResource GroupPathVisibility}" Text="{Binding Path}" Foreground="{DynamicResource Brush7E8981}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></HierarchicalDataTemplate>
      <DataTemplate DataType="{x:Type local:WorkspaceSession}"><StackPanel MaxWidth="{DynamicResource RowWidth}"><TextBlock Text="{Binding Info.Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Info.Title}"/><TextBlock Visibility="{DynamicResource SessionDateVisibility}" Text="{Binding Info.DisplayTime}" Foreground="{DynamicResource Brush7E8981}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate>
     </TreeView.Resources>
    </TreeView>
   </DockPanel>
  </Border>
  <Border Grid.Column="2" CornerRadius="{DynamicResource ContentRadius}" Background="{DynamicResource BrushFCFCFA}"><Grid Margin="{DynamicResource ContentMargin}">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="ConversationPage">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="{DynamicResource HeaderMargin}">
     <Button DockPanel.Dock="Right" Content="收缩" Click="Compact_Click" ToolTip="收缩为迷你输入窗口" AutomationProperties.Name="收缩为迷你窗口" VerticalAlignment="Top"/>
     <Border DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,12,0" Padding="10,6" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BrushCFD9CF}" ToolTip="当前远端连接与所选 Agent 会话状态">
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionStateDot" Width="11" Height="11" Fill="#DC2626" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionStateLabel" Text="已断连" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     </Border>
     <Button x:Name="ArchiveButton" DockPanel.Dock="Right" Style="{StaticResource Compact}" VerticalAlignment="Top" Content="归档" Click="Archive_Click" IsEnabled="False"/><Button DockPanel.Dock="Right" Content="复制对话" Click="CopyChat_Click" Style="{StaticResource Compact}" VerticalAlignment="Top"/>
     <StackPanel ToolTip="{Binding Text, ElementName=SessionMeta}"><TextBlock x:Name="SessionTitle" Text="从一段对话开始" FontSize="{DynamicResource HeaderSize}" FontWeight="SemiBold"/><TextBlock x:Name="SessionMeta" Visibility="{DynamicResource OriginalOnly}" Text="连接设备，选择已有会话或新建会话。" TextWrapping="Wrap" Foreground="{DynamicResource Brush748078}" Margin="0,8,0,0"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">


     <StackPanel Panel.ZIndex="1" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="410"><TextBlock x:Name="EmptyTitle" Text="你的 Agent，随时继续。" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="在这里阅读消息、给出指令并处理确认。&#10;设备和服务端配置都在「设置」中。" TextAlignment="Center" Foreground="{DynamicResource Brush7A877E}" TextWrapping="Wrap" Margin="0,16,0,20"/><Button x:Name="EmptyConnect" Content="连接远端设备" Click="OpenConnect_Click" HorizontalAlignment="Center"/></StackPanel>
     <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="{DynamicResource ConversationScrollBar}" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="OlderHistoryButton" Content="加载更早记录" Visibility="Collapsed" Click="OlderHistory_Click"/><Button x:Name="LatestHistoryButton" Content="返回最新" Visibility="Collapsed" Click="LatestHistory_Click"/></StackPanel><ItemsControl x:Name="Messages"><ItemsControl.ItemTemplate><DataTemplate><local:ChatMessageView/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel x:Name="OutputFilesPanel"/></StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" x:Name="PromptBorder" Visibility="Collapsed" Background="{DynamicResource BrushFFF2D7}" CornerRadius="9" Padding="15" Margin="0,8,0,10" MaxHeight="235"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PromptPanel"/></ScrollViewer></Border>
    <StackPanel x:Name="ComposerStack" Grid.Row="3">
     <WrapPanel x:Name="ConversationTools" Margin="0,0,0,4">
      <Button x:Name="PasteImageButton" Style="{StaticResource IconButton}" Click="PasteImage_Click" ToolTip="粘贴图片" AutomationProperties.Name="粘贴图片"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M3,3 L17,3 17,17 3,17 Z M3,13 L7,9 11,13 14,10 17,13 M7,6 L8,6 8,7 7,7 Z"/></Button>
      <Button x:Name="UploadButton" Style="{StaticResource IconButton}" Click="Upload_Click" IsEnabled="False" ToolTip="添加文件" AutomationProperties.Name="添加文件"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M7,11 L12,6 Q16,2 18,6 Q19,8 16,11 L9,18 Q5,21 2,17 Q0,14 4,10 L11,3 M5,13 L12,6"/></Button>
      <Button x:Name="FilesButton" Style="{StaticResource IconButton}" Click="Files_Click" IsEnabled="False" ToolTip="会话文件 / 下载" AutomationProperties.Name="会话文件 / 下载"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M2,16 L2,4 8,4 10,6 18,6 18,16 Z M10,8 L10,14 M7,11 L10,14 13,11"/></Button>
      <Button x:Name="ClearFilesButton" Style="{StaticResource IconButton}" Click="ClearFiles_Click" ToolTip="移除待发附件" AutomationProperties.Name="移除待发附件"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M3,5 L17,5 M7,5 L7,2 13,2 13,5 M5,5 L6,18 14,18 15,5 M8,8 L8,15 M12,8 L12,15"/></Button>
      <Button x:Name="CancelTransferButton" Content="取消传输" Click="CancelTransfer_Click" Visibility="Collapsed" Style="{StaticResource Compact}"/>
     </WrapPanel>
    <Border x:Name="ComposerSurface" BorderBrush="{DynamicResource BrushCFD9CF}" BorderThickness="1" CornerRadius="{DynamicResource ComposerRadius}" Background="White" Padding="{DynamicResource ComposerPadding}" Margin="0">
     <StackPanel>
      <TextBlock x:Name="AttachmentSummary" TextWrapping="Wrap" Foreground="{DynamicResource Brush537363}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Grid><TextBox x:Name="Composer" Padding="0" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" TextAlignment="Left" MinHeight="{DynamicResource ComposerMinHeight}" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfFontMargin}}" IsEnabled="False" PreviewKeyDown="Composer_KeyDown" AutomationProperties.Name="消息输入"/><TextBlock Text="输入消息，继续远端任务…" Foreground="#C5C5C5" Margin="7,7,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=Composer}" Value=""/><Condition Binding="{Binding (local:VisualTheme.IsCodex), RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <DockPanel Margin="{DynamicResource ComposerFooterMargin}"><Button Margin="0" x:Name="SendButton" DockPanel.Dock="Right" Content="发送" Click="Send_Click" Style="{DynamicResource SendStyle}" IsEnabled="False"/><Button Margin="0" x:Name="InterruptSendButton" DockPanel.Dock="Right" Content="打断并发送" Click="InterruptSend_Click" ToolTip="停止当前运行，确认结束后发送新消息" Style="{DynamicResource RuntimeButtonStyle}" IsEnabled="False"/><Button Margin="0" x:Name="StopButton" DockPanel.Dock="Right" Content="停止" Click="Stop_Click" Style="{DynamicResource RuntimeButtonStyle}" IsEnabled="False"/><ContentControl x:Name="FooterToolsHost" DockPanel.Dock="Left" VerticalAlignment="Center"/><WrapPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource ModelAlignment}"><Button Margin="0" x:Name="ModelButton" Background="{DynamicResource ModelButtonBackground}" MaxWidth="260" Content="模型与模式" Click="Model_Click" Style="{StaticResource Compact}" IsEnabled="False"/><ComboBox x:Name="DeliveryPicker" SelectedIndex="0" Width="76" Height="26" MinHeight="0" Padding="3,1" Margin="5,0" FontSize="11" Visibility="Collapsed" SelectionChanged="Delivery_Changed" ToolTip="自动：执行中追加，空闲时发送；排队：等待下一轮；追加：进入当前执行步骤的待处理队列"><ComboBoxItem Content="自动"/><ComboBoxItem Content="排队"/><ComboBoxItem Content="追加"/></ComboBox><TextBlock Visibility="{DynamicResource ComposerHintVisibility}" Text="Ctrl + Enter 发送" Foreground="{DynamicResource Brush859088}" FontSize="11" VerticalAlignment="Center"/></WrapPanel></DockPanel>
     </StackPanel>
    </Border>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="660" HorizontalAlignment="Left">
     <TextBlock Text="设置" FontSize="{DynamicResource PageTitleSize}" FontWeight="SemiBold"/><TextBlock Text="配置连接与本机共享，回到会话即可继续工作。" Foreground="{DynamicResource Brush77847B}" Margin="0,8,0,30"/>
     <TextBlock Text="界面风格" FontSize="{DynamicResource SectionTitleSize}" FontWeight="SemiBold"/><ComboBox x:Name="ThemePicker" SelectionChanged="Theme_Changed" AutomationProperties.Name="界面风格"><ComboBoxItem Content="Codex 风格（浅色）"/><ComboBoxItem Content="原始风格"/></ComboBox><TextBlock Text="立即生效并记住选择，不影响设备连接、会话和草稿。" Foreground="{DynamicResource Brush77847B}" Margin="0,0,0,24"/><TextBlock Text="中继服务" FontSize="{DynamicResource SectionTitleSize}" FontWeight="SemiBold"/><TextBlock Text="服务端地址" Margin="0,16,0,0"/><TextBox x:Name="ServerUrl" Text="https://furtheragent.fennecmomo.top" MinWidth="540"/><Button Content="保存地址" Click="SaveSettings_Click" HorizontalAlignment="Left"/><TextBlock Text="保存后用于下一次连接。双方使用同一中继，连接设备只需授权码。" TextWrapping="Wrap" Foreground="{DynamicResource Brush77847B}" Margin="0,8,0,24"/>
     <TextBlock Text="当前远端" FontSize="{DynamicResource SectionTitleSize}" FontWeight="SemiBold"/><ComboBox x:Name="AgentPicker" IsEnabled="False"/><Button x:Name="DisconnectButton" Content="断开远端连接" Click="Disconnect_Click" IsEnabled="False" HorizontalAlignment="Left"/>
     <Button Content="忘记已保存连接" Click="ForgetConnection_Click" HorizontalAlignment="Left"/><TextBlock Text="成功连接后记住设备，启动时自动重连。主动断开后暂停自动连接；授权码仅当前 Windows 用户可解密。" TextWrapping="Wrap" Foreground="{DynamicResource Brush77847B}"/><Separator Margin="0,22"/><TextBlock Text="共享本机 Agent" FontSize="{DynamicResource SectionTitleSize}" FontWeight="SemiBold"/><TextBlock Text="选择要共享的本机 Agent。DSH 桌面需先安装插件；独立后台使用单独的账号与会话配置。授权码仅提供给可信任的人。" TextWrapping="Wrap" Foreground="{DynamicResource Brush77847B}" Margin="0,10"/>
     <ComboBox x:Name="LocalBackend" SelectedIndex="0"><ComboBoxItem Content="Codex 桌面"/><ComboBoxItem Content="DSH 桌面（同一 Host）"/><ComboBoxItem Content="DSH 独立后台（隔离会话）"/></ComboBox>
       <TextBlock Text="DSH 桌面程序路径（后台模式使用其匹配运行时）" Foreground="{DynamicResource Brush77847B}"/><TextBox x:Name="DshExecutable" Text="D:\Software\DeepseekHarness\DeepSeek Harness.exe"/>
       <Button x:Name="ShareButton" Content="开启共享" Click="Share_Click" HorizontalAlignment="Left"/><TextBox x:Name="LocalCode" IsReadOnly="True" Text="尚未开启共享" FontFamily="Consolas"/><Button x:Name="CopyCodeButton" Content="复制授权码" Click="CopyCode_Click" IsEnabled="False" HorizontalAlignment="Left"/><Button Content="重置本机配对码" Click="ResetPairing_Click" ToolTip="停止本机共享并更换配对码；日常重启和更新不需要重置" HorizontalAlignment="Left"/><TextBlock x:Name="HostStatus" Text="共享停止时会断开远程控制端。" TextWrapping="Wrap" Foreground="{DynamicResource Brush77847B}"/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="1" Margin="0,6,0,0"><WrapPanel Visibility="{DynamicResource DiagnosticVisibility}"><TextBlock x:Name="RelayHealth" Text="中继：未连接" FontSize="11" Margin="0,0,18,0"/><TextBlock x:Name="HostHealth" Text="客户端 B：未连接" FontSize="11"/><TextBlock x:Name="TrafficStatus" FontSize="11" Margin="18,0,0,0" ToolTip="当前 WebSocket 连接的应用数据；不含 TLS 开销和独立 HTTP 健康检查，重连后重新计数。"/></WrapPanel><TextBlock x:Name="ActivityStatus" Visibility="{DynamicResource DiagnosticVisibility}" Text="连接未就绪" Foreground="{DynamicResource Brush537363}" FontSize="12" Margin="0,3,0,0"/><TextBlock x:Name="StatusBar" Text="就绪" Foreground="{DynamicResource Brush758178}" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="40"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
  </Grid></Border>
  <Border x:Name="ConnectOverlay" Grid.ColumnSpan="3" Background="{DynamicResource Brush660F2118}" Visibility="Collapsed">
   <Border Background="{DynamicResource BrushFCFCFA}" CornerRadius="14" Padding="30" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="连接设备" FontSize="{DynamicResource DialogTitleSize}" FontWeight="SemiBold"/><TextBlock Text="输入远端设备显示的授权码。" Margin="0,12" Foreground="{DynamicResource Brush748078}"/><TextBlock Text="选择已有连接，或点击新增连接填写另一台设备。" Foreground="{DynamicResource Brush748078}" TextWrapping="Wrap"/><DockPanel><Button x:Name="NewConnectionButton" DockPanel.Dock="Right" Content="＋ 新增连接" Click="NewConnection_Click"/><ComboBox x:Name="SavedConnectionsList" DisplayMemberPath="Name" SelectionChanged="SavedConnection_Changed" AutomationProperties.Name="已保存的连接" MinWidth="180" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="ConnectionName" AutomationProperties.Name="连接名称" ToolTip="连接名称"/><TextBlock x:Name="ConnectServer" TextWrapping="Wrap" Foreground="{DynamicResource Brush748078}"/><TextBox x:Name="RemoteCode" FontFamily="Consolas" FontSize="18" AutomationProperties.Name="远端授权码"/><TextBlock x:Name="ConnectError" Foreground="{DynamicResource BrushA34036}" TextWrapping="Wrap"/><WrapPanel><Button x:Name="ConnectButton" Content="连接" Click="Connect_Click" Style="{StaticResource Primary}"/><Button Content="取消" Click="CloseOverlay_Click"/><Button Content="修改服务端" Click="Settings_Click"/><Button Content="保存此连接" Click="SaveConnection_Click"/><Button Content="删除所选" Click="DeleteConnection_Click"/></WrapPanel></StackPanel></Border>
  </Border>
