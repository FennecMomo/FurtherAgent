<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FurtherAgent.AndroidApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>FurtherAgent</ApplicationTitle>
    <ApplicationId>top.fennecmomo.furtheragent</ApplicationId>
    <ApplicationDisplayVersion>0.12.1</ApplicationDisplayVersion>
    <Version>0.12.1</Version>
    <ApplicationVersion>1201</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Avoid MAUI 10 Release JNI registration crash; see dotnet/maui#35209. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Preserve binary locality for APK deltas; assembly blobs already contain compressed assemblies. -->
    <AndroidStoreUncompressedFileExtensions>.so</AndroidStoreUncompressedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <ProjectReference Include="../FurtherAgent.Mobile/FurtherAgent.Mobile.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#183F34" />
    <MauiImage Include="Resources/Images/*.svg" BaseSize="24,24" />
    <MauiAsset Include="Resources/Images/LUCIDE-LICENSE.txt" LogicalName="third-party/LUCIDE-LICENSE.txt" />
    <MauiSplashScreen Include="Resources/AppIcon/appicon.svg" Color="#F6F8F5" BaseSize="100,100" />
  </ItemGroup>
</Project>
