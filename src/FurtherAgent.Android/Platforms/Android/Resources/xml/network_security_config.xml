<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <base-config cleartextTrafficPermitted="false"><trust-anchors><certificates src="system" /></trust-anchors></base-config>
  <!-- Keep platform network stacks restricted to HTTPS outside USB development.
       The managed relay transport validates explicitly configured HTTP IP addresses in Core. -->
  <domain-config cleartextTrafficPermitted="true"><domain>127.0.0.1</domain><domain>localhost</domain></domain-config>
</network-security-config>
