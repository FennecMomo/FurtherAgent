[Unit]
Description=FurtherAgent Hermes connector
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/furtheragent
ExecStart=%h/.local/share/furtheragent/FurtherAgent.Host
EnvironmentFile=%h/.config/furtheragent/host.env
Environment=FURTHERAGENT_IDENTITY_FILE=%h/.config/furtheragent/hermes-default.identity
# Run journals survive Host restarts; keep restart policy explicit until server acceptance.
Restart=no
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
